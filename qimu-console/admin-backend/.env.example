# ============ admin-backend（Spring Boot 管理后端）环境变量模板 ============
# 在部署环境（systemd / docker / 面板）注入同名环境变量；本地 IDE 直接跑无需设置（走 application.yml 本地默认值）。

# JWT 密钥（生产必填）：openssl rand -hex 32 生成，必须与 alon-workbench 的 JWT_SECRET 一致
JWT_SECRET=

# 运行环境标记：本地开发留空；生产务必设 production（开启 JWT_SECRET 缺失即拒绝启动的保护）
APP_ENV=production

# MySQL 连接（本地默认 127.0.0.1:3306 / root / 空密码 / qimu_platform）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qimu_platform
DB_USERNAME=root
DB_PASSWORD=

# CORS 允许的来源（逗号分隔）
# CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Redis（缓存监控 + 在线会话镜像；本地默认 127.0.0.1:6379 / 无密码 / db0）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Druid 数据监控控制台（/druid/*）登录账密，生产务必自定义
DRUID_USERNAME=admin
DRUID_PASSWORD=admin

# SQLite→MySQL 一次性迁移（默认关闭；仅首次从旧 SQLite 迁库时需要）
MIGRATE_ENABLED=false
MIGRATE_SQLITE=
# 迁移初始密码：可选项。不设置时按用户生成随机一次性密码并输出到启动日志。
# MIGRATE_DEFAULT_PASSWORD=
