# ============ qimu-desk（工作台）环境变量模板 ============
# 复制为 .env 并填入真实值；.env 已被 gitignore，不会进入版本库。

# 工作台的对外访问地址（用于 cookie 安全策略与请求来源校验）
# 本地开发：http://localhost:3010 ；服务器部署：https://你的域名
APP_URL=http://localhost:3010

# 会话密钥（随机长字符串）
SESSION_SECRET=please-change-me-to-a-long-random-string

# ============ 认证 / JWT（与 admin-backend 保持一致） ============
# 生产环境【必须】设置：openssl rand -hex 32 生成，且两端（工作台 + 后端）使用同一个值
# JWT_SECRET=请填写一个≥32位的随机字符串

# ============ MySQL（与 admin-backend 共享 qimu_platform 库） ============
# 本地开发默认连 127.0.0.1:3306 / root / 空密码，无需设置以下变量
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=qimu_platform

# ============ 管理后端地址（Spring Boot） ============
# 本地开发默认 http://localhost:8080
# ADMIN_BACKEND_URL=http://localhost:8080

# ============ 聊天功能（chat-module） ============
# WebSocket 地址：不设 = 同域 ws(s)://<当前域名>/ws/chat（生产推荐，OpenResty 反代）；
# 本地开发跨端口联调时设为：NEXT_PUBLIC_WS_BASE=ws://localhost:8080
# NEXT_PUBLIC_WS_BASE=

# 聊天写请求（发送/已读兜底）打到后端 REST 的地址：
# 不设 = 同源 /api/backend/chat/*（生产由 OpenResty 转发到 :8080/api/chat/*）；
# 本地开发跨端口联调时设为：NEXT_PUBLIC_CHAT_API_BASE=http://localhost:8080
# NEXT_PUBLIC_CHAT_API_BASE=

# ============ 时区 ============
TZ=Asia/Shanghai

# 管理后台前端（本地开发）
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3011

# 可选：本地首页预览（仅 next dev + localhost 生效，不授予真实业务权限）
# LOCAL_PREVIEW_ENABLED=true
# LOCAL_PREVIEW_PASSWORD=设置临时密码
# LOCAL_PREVIEW_SECRET=设置随机会话签名密钥

# AI 能力配置加密密钥（至少 32 位；未设置时使用 JWT_SECRET）
# 备份数据库时同时保留此密钥；更换密钥会导致旧能力配置无法解密。
# AI_CAPABILITY_SECRET=
# 允许 MCP 连接的内网 origin，逗号分隔。默认仅允许公网地址；按需指定精确协议、主机和端口。
# AI_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000
